# Copia este archivo como .env y pon los datos de TU proyecto de Supabase
# (Supabase → Project Settings → API).
# En Vercel: Settings → Environment Variables (las mismas dos).
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_KEY=TU_CLAVE_PUBLISHABLE_O_ANON
# Dirección oficial de tu app: los QR de los productos apuntan aquí (recomendado)
VITE_PUBLIC_URL=https://TU-APP.vercel.app
